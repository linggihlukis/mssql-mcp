# Copy this file to .env and replace the placeholders.
# Do not commit .env. The names must match username_env and password_env in config.json.
SQL_MCP_USERNAME=your-sql-login
SQL_MCP_PASSWORD=your-real-password
MYSQL_USERNAME=your-mysql-login
# A local MySQL account may have no password. Leave the value empty; do not delete the line.
MYSQL_PASSWORD=
