{
  "connections": [
    {
      "name": "sqlserver",
      "db_type": "mssql",
      "host": "127.0.0.1",
      "port": 1433,
      "database": "YourDatabase",
      "username_env": "MSSQL_MCP_USERNAME",
      "password_env": "MSSQL_MCP_PASSWORD",
      "read_only": true,
      "max_row_limit": 500,
      "query_timeout_ms": 60000,
      "connection_timeout_ms": 10000,
      "options": {
        "encrypt": false,
        "trustServerCertificate": true,
        "enableArithAbort": true
      }
    }
  ]
}
